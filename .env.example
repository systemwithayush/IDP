# IDP Environment Configuration Template
# DO NOT COMMIT SECRETS TO SOURCE CONTROL

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (MySQL 8)
DATABASE_URL="mysql://idp_user:idp_password@localhost:3306/idp_db"

# Authentication (JWT)
# Generate using: openssl rand -base64 32
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_long_example
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long_example
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Secrets Encryption (AES-256-GCM, 32 bytes base64)
# Generate using: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=DkPQw/jXfmijKhyZKt39jzs8zesUYkZXDjzrKRuEiIY=

# GitHub Integration
GITHUB_TOKEN=ghp_exampletokenforgithubactionsdispatch
GITHUB_WEBHOOK_SECRET=example_webhook_secret_for_hmac_verification
GITHUB_OWNER=systemwithayush

# Kubernetes
KUBECONFIG_PATH=~/.kube/config
K8S_DEFAULT_NAMESPACE=default

# AI Infrastructure Advisory (OpenAI)
OPENAI_API_KEY=sk-mock-key-for-development-and-offline-tests

# Notifications
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_smtp_user
SMTP_PASS=mock_smtp_password
SMTP_FROM="IDP Platform <no-reply@idp.internal>"
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/MOCK/WEBHOOK/URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/mock/webhook/url

